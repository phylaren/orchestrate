{
  "info": {
    "_postman_id": "6f1d2a5e-8c3b-4d47-9a10-5b7e2c9d4f31",
    "name": "Orchestrate — ключовий сценарій: від дому до підтвердженого виконання",
    "description": "Наскрізний інтеграційний сценарій: два користувачі, домогосподарство, запрошення, обов'язок із підтвердженням, ротація відповідального.\n\nЗапуск: `npx newman run collection.json -e env.json` (застосунок має працювати на {{baseUrl}}).\nПоточний користувач передається заголовком X-User-Id; усі змінні сценарію (runId, aliceId, bobId, householdId, ...) колекція створює сама.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Виконується після КОЖНОГО запиту колекції",
          "pm.test(\"Відповідь містить заголовок X-Trace-Id\", function () {",
          "    pm.response.to.have.header(\"X-Trace-Id\");",
          "});",
          "pm.test(\"Відповідь надійшла швидше за 2000 мс\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Підготовка: користувачі",
      "description": "",
      "item": [
        {
          "name": "1.1 Створити користувача Alice (власник)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Унікальний суфікс запуску, щоб email не конфліктував між прогонами",
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Заголовок Location вказує на нового користувача\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/users/\");",
                  "});",
                  "pm.test(\"X-Trace-Id із запиту повертається у відповіді\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.eql(\"newman-\" + pm.collectionVariables.get(\"runId\"));",
                  "});",
                  "pm.test(\"Тіло містить згенерований UUID та email\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(json.email).to.eql(\"alice.\" + pm.collectionVariables.get(\"runId\") + \"@example.com\");",
                  "    pm.collectionVariables.set(\"aliceId\", json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "newman-{{runId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alice Owner\",\n  \"email\": \"alice.{{runId}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
