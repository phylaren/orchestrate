            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Помилка у форматі ProblemDetail з кодом VALIDATION_FAILED\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(400);",
                  "    pm.expect(body.code).to.eql(\"VALIDATION_FAILED\");",
                  "});",
                  "pm.test(\"Помилка вказує на поле email\", function () {",
                  "    const fields = pm.response.json().errors.map(e => e.field);",
                  "    pm.expect(fields).to.include(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
