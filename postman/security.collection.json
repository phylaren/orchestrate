    },
    {
      "name": "1. Без токена → 401",
      "item": [
        {
          "name": "1. Запит без токена → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Тіло — ProblemDetail (RFC 9457) з кодом AUTHENTICATION_REQUIRED\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(\"AUTHENTICATION_REQUIRED\");",
                  "    pm.expect(json).to.have.all.keys(\"type\", \"title\", \"status\", \"detail\", \"instance\", \"timestamp\", \"code\");",
                  "});",
                  "pm.test(\"Заголовок WWW-Authenticate: Bearer\", function () {",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql(\"Bearer\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "newman-security-{{runId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "1a. Підроблений токен → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"invalidToken\", \"eyJhbGciOiJIUzM4NCJ9.e30.forged-signature\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Тіло — ProblemDetail (RFC 9457) з кодом INVALID_TOKEN\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(\"INVALID_TOKEN\");",
                  "    pm.expect(json).to.have.all.keys(\"type\", \"title\", \"status\", \"detail\", \"instance\", \"timestamp\", \"code\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "newman-security-{{runId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{invalidToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            }
          }
        }
      ]
