    {
      "name": "2. Вхід → токен",
      "item": [
        {
          "name": "2. Вхід власника → токен",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Відповідь містить токен типу Bearer\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(json.accessToken.split(\".\")).to.have.lengthOf(3);",
                  "    pm.expect(json.expiresIn).to.be.above(0);",
                  "    pm.collectionVariables.set(\"ownerToken\", json.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "newman-security-{{runId}}",
