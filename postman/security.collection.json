    {
      "name": "3. З токеном → 200",
      "item": [
        {
          "name": "3. Запит з токеном → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус відповіді 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Користувача визначено за токеном\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get(\"ownerId\"));",
                  "    pm.expect(json.roles).to.include(\"ROLE_USER\");",
                  "});",
                  "pm.test(\"Сесія не створюється (stateless)\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
