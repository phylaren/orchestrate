# Шаблон змінних оточення для docker-compose.yml.
# Скопіювати у .env і замінити значення; сам .env не комітиться.

# База даних PostgreSQL (використовується і контейнером postgres, і застосунком).
POSTGRES_DB=orchestrate
POSTGRES_USER=orchestrate
POSTGRES_PASSWORD=change-me

# Секрет підпису JWT, мінімум 32 байти. Згенерувати: openssl rand -base64 48
ORCHESTRATE_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# Webhook для сповіщень; у профілі prod обов'язковий.
ORCHESTRATE_NOTIFICATION_WEBHOOK_URL=https://example.com/webhook

# Дозволені CORS-джерела через кому.
ORCHESTRATE_SECURITY_CORS_ALLOWED_ORIGINS=https://orchestrate.example.com

NGINX_MODE=tunnel
NGINX_BIND_ADDRESS=127.0.0.1

NGINX_MODE=tunnel
NGINX_BIND_ADDRESS=127.0.0.1
